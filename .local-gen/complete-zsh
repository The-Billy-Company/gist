  options:-corpus:Corpus\ —\ which\ bytes\ are\ searched
  options:-semantics:Semantics\ —\ what\ counts\ as\ a\ match
  options:-presentation:Presentation\ —\ how\ the\ answer\ is\ shown
  options:-execution:Execution\ —\ how\ it\ is\ computed
