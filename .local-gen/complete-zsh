_gist_verbs() {
  local -a c=(
    'index:build and persist the trigram index over ROOT (default: this tree)'
    'status:is an index ready, how fresh, how big'
    'serve:run the resident warm session (auto-spawned; run it to scope the roots)'
    'codex:exact corpus-wide literal counts off the compressed self-index'
    'search:the ordinary search, addressed with a verb'
    'rg:the same engine under the name an alias would give it'
  )
  _describe -t commands 'command' c
}

_gist() {
  local curcontext="$curcontext" ret=1
  # Undo spellings are noise until they are asked for — `!` keeps them
  # understood but unoffered. Typing `--no` brings them back.
  local no='!'
  [[ $PREFIX == --no* ]] && no=''
  local -a args
  args=(
    '(-i --ignore-case -s --case-sensitive -S --smart-case)'{-i,--ignore-case}'[match case-insensitively]'
    '(-i --ignore-case -s --case-sensitive -S --smart-case)'{-s,--case-sensitive}'[match case-sensitively]'
    '(-i --ignore-case -s --case-sensitive -S --smart-case)'{-S,--smart-case}'[match case-insensitively unless the pattern has uppercase]'
    '(-w --word-regexp -x --line-regexp)'{-w,--word-regexp}'[require a word boundary on both sides of a match]'
    '(-F --fixed-strings)'{-F,--fixed-strings}'[read the pattern as literal bytes, not a regex]'
    '(-v --invert-match)'{-v,--invert-match}'[print the lines that do not match]'
    '(-o --only-matching)'{-o,--only-matching}'[print only the matched part of each line]'
    '(-n --line-number -N --no-line-number)'{-n,--line-number}'[prefix each line with its line number]'
    $no'(-n --line-number -N --no-line-number)'{-N,--no-line-number}'[omit line numbers]'
    '(-H --with-filename -I --no-filename)'{-H,--with-filename}'[prefix each line with its file path]'
    $no'(-H --with-filename -I --no-filename)'{-I,--no-filename}'[omit file paths]'
    '(-l --files-with-matches --files-without-match -c --count --count-matches --json --files --type-list)'{-l,--files-with-matches}'[print only the paths that contain a match]'
    '(-l --files-with-matches --files-without-match -c --count --count-matches --json --files --type-list)''--files-without-match[print only the paths that contain no match]'
    '(-l --files-with-matches --files-without-match -c --count --count-matches --json --files --type-list)'{-c,--count}'[print how many lines matched, per file]'
    '(-l --files-with-matches --files-without-match -c --count --count-matches --json --files --type-list)''--count-matches[print how many matches there were, per file]'
    '(--include-zero --no-include-zero)''--include-zero[in a count mode, also print the files with no match]'
    $no'(--include-zero --no-include-zero)''--no-include-zero[omit zero-count files, the default]'
    '--hidden[search hidden files and directories]'
    '(-a --text)'{-a,--text}'[search binary files as if they were text]'
    '--binary[search binary files and print every matching line]'
    '(-u --unrestricted)'{-u,--unrestricted}'[filter less: -u ignore rules, -uu also hidden, -uuu also binary]'
    '(--column --no-column)''--column[print the column of the first match on each line]'
    $no'(--column --no-column)''--no-column[omit columns]'
    '(-b --byte-offset)'{-b,--byte-offset}'[print the byte offset of each matching line]'
    '--vimgrep[one line per match, in vim'\''s quickfix shape]'
    '(--heading --no-heading)''--heading[group matches under their filename]'
    $no'(--heading --no-heading)''--no-heading[prefix every line with its path instead of grouping]'
    '(--trim --no-trim)''--trim[strip leading whitespace from every printed line]'
    '(-0 --null)'{-0,--null}'[terminate each printed path with NUL]'
    '--null-data[treat NUL, not newline, as the line terminator]'
    '(-w --word-regexp -x --line-regexp)'{-x,--line-regexp}'[require the pattern to match a whole line]'
    '(-q --quiet)'{-q,--quiet}'[print nothing and stop at the first match]'
    '(--stats --no-stats)''--stats[print search statistics after the results]'
    '--stop-on-nonmatch[stop a file at its first non-matching line]'
    '(--passthru --passthrough)'{--passthru,--passthrough}'[print every line, matching or not]'
    '--max-columns-preview[show a truncated preview of an elided long line]'
    '--field-match-separator=[the separator between a match line'\''s fields]:SEPARATOR:'
    '--field-context-separator=[the separator between a context line'\''s fields]:SEPARATOR:'
    '--crlf[treat CRLF as the line terminator]'
    '(-U --multiline)'{-U,--multiline}'[let one match span line boundaries]'
    '--multiline-dotall[multiline, and let . match a newline too]'
    '(-l --files-with-matches --files-without-match -c --count --count-matches --json --files --type-list)''--json[emit results as JSON Lines]'
    '(-l --files-with-matches --files-without-match -c --count --count-matches --json --files --type-list)''--files[list every file that would be searched]'
    '(-l --files-with-matches --files-without-match -c --count --count-matches --json --files --type-list)''--type-list[list every file type and the globs it covers]'
    '(-L --follow --no-follow)'{-L,--follow}'[follow symbolic links]'
    $no'(-L --follow --no-follow)''--no-follow[do not follow symbolic links]'
    '(--sort-files --sort --sortr)''--sort-files[sort by path (rg'\''s deprecated spelling of --sort=path)]'
    '(--sort-files --sort --sortr)''--sort=[sort the results ascending by this key]:SORTKEY:_gist_sortkey'
    '(--sort-files --sort --sortr)''--sortr=[sort the results descending by this key]:SORTKEY:_gist_sortkey'
    '--glob-case-insensitive[match every --glob case-insensitively]'
    '(-A --after-context)'{-A+,--after-context=}'[print this many lines after each match]:NUM:'
    '(-B --before-context)'{-B+,--before-context=}'[print this many lines before each match]:NUM:'
    '(-C --context)'{-C+,--context=}'[print this many lines on both sides of each match]:NUM:'
    '(-m --max-count)'{-m+,--max-count=}'[stop after this many matches in each file]:NUM:'
    '*'{-e+,--regexp=}'[add a pattern; repeatable, and safe for one starting with a dash]:PATTERN:'
    '*'{-t+,--type=}'[search only files of this type]:TYPE:_gist_type'
    '*'{-T+,--type-not=}'[skip files of this type]:TYPE:_gist_type'
    '*'{-g+,--glob=}'[include paths matching this glob, or exclude with a leading !]:GLOB:_files'
    '*''--iglob=[as --glob, matched case-insensitively]:GLOB:_files'
    '(-M --max-columns)'{-M+,--max-columns=}'[elide any line longer than this many columns]:NUM:'
    '--path-separator=[the separator printed between path components]:SEPARATOR:'
    '(--max-depth --maxdepth)'{--max-depth=,--maxdepth=}'[descend at most this many directories]:NUM:'
    '--max-filesize=[skip files larger than this size]:SIZE:'
    '(--context-separator --no-context-separator)''--context-separator=[the line printed between non-adjacent context blocks]:SEPARATOR:'
    $no'(--context-separator --no-context-separator)''--no-context-separator[print nothing between context blocks]'
    '(-r --replace)'{-r+,--replace=}'[print this text in place of each match]:TEXT:'
    '*'{-f+,--file=}'[read patterns from a file, one per line]:FILE:_files'
    '*''--type-add=[define or extend a file type, as name:glob]:TYPESPEC:'
    '--color=[when to colorize the output]:WHEN:_gist_when'
    '(--hyperlink --link --no-hyperlink --no-link --hyperlink-format)'{--hyperlink=-,--link=-}'[make paths clickable: a posture, an editor alias, or a format]::TARGET:_gist_target'
    $no'(--hyperlink --link --no-hyperlink --no-link --hyperlink-format)'{--no-hyperlink,--no-link}'[never emit hyperlinks]'
    '(--hyperlink --link --no-hyperlink --no-link --hyperlink-format)''--hyperlink-format=[the hyperlink template, or an editor alias]:TARGET:_gist_target'
    '--hostname-bin=[a command whose output supplies {host} in a hyperlink]:COMMAND:_cmdstring'
    $no'--no-ignore[obey no ignore file at all]'
    $no'--no-ignore-vcs[obey no .gitignore rules]'
    $no'--no-ignore-dot[obey no .ignore rules]'
    $no'--no-ignore-parent[obey no ignore rules from parent directories]'
    $no'--no-ignore-exclude[obey no .git/info/exclude rules]'
    $no'(--no-ignore-files --ignore-files)''--no-ignore-files[obey no --ignore-file source]'
    '(--no-ignore-files --ignore-files)''--ignore-files[obey --ignore-file sources again]'
    $no'(--no-require-git --require-git)''--no-require-git[apply git ignore rules outside a repository too]'
    '(--no-require-git --require-git)''--require-git[apply git ignore rules only inside a repository]'
    '--ignore-file-case-insensitive[match ignore-file globs case-insensitively]'
    '*''--ignore-file=[read more ignore rules from this file]:FILE:_files'
    $no'--no-ignore-global[obey no global git excludesFile]'
    $no'(--no-messages --messages)''--no-messages[suppress per-file errors, but not the exit code they set]'
    '(--no-messages --messages)''--messages[print per-file errors]'
    $no'(--no-ignore-messages --ignore-messages)''--no-ignore-messages[suppress errors from unreadable ignore sources]'
    '(--no-ignore-messages --ignore-messages)''--ignore-messages[print errors from unreadable ignore sources]'
    $no'(--no-index --index)''--no-index[scan live, ignoring any persisted index]'
    '(--no-index --index)''--index[use the persisted index when one is current]'
    '--rank=-[ranked view: definitions first, generated files demoted]::N:'
    '--uncap[lift the soft output budget for this query]'
    '--in-comments[keep only the matches that fall inside a comment]'
    '--in-code[keep only the matches that fall outside every comment]'
    $no'(--mmap --no-mmap)'{--mmap,--no-mmap}'[accepted for rg parity; gist picks its own read strategy]'
    $no'--no-config[ignore the committed charter and the personal preferences file]'
    '--one-file-system[do not descend across a filesystem boundary]'
    '(--unicode --no-unicode)''--unicode[Unicode mode: codepoint classes and full case folding]'
    $no'(--unicode --no-unicode)''--no-unicode[byte mode: single-byte classes and ASCII word boundaries]'
    $no'(--stats --no-stats)''--no-stats[print no search statistics]'
    $no'(--trim --no-trim)''--no-trim[keep leading whitespace]'
    '--colors=[accepted for rg parity; the spec is validated, then discarded]:SPEC:'
    '(-j --threads)'{-j+,--threads=}'[cap the worker pool at this many, or 0 for gist'\''s own topology]:NUM:'
    '(--engine -P --pcre2 --auto-hybrid-regex)''--engine=[which match backend to compile the pattern with]:ENGINE:_gist_engine'
    '(--pcre2-unicode --no-pcre2-unicode)''--pcre2-unicode[PCRE2 Unicode mode, under -P or an escalated --engine auto]'
    $no'(--pcre2-unicode --no-pcre2-unicode)''--no-pcre2-unicode[PCRE2 raw-byte mode, under the same two backends]'
    '(--dfa-size-limit --regex-size-limit)'{--dfa-size-limit=,--regex-size-limit=}'[accepted for rg parity; gist'\''s engines have no such ceiling]:VALUE:'
    '(--engine -P --pcre2 --auto-hybrid-regex)'{-P,--pcre2}'[use PCRE2: lookaround, backreferences, Unicode properties]'
    '(--engine -P --pcre2 --auto-hybrid-regex)''--auto-hybrid-regex[escalate to PCRE2 only when needed (rg'\''s spelling of --engine auto)]'
    '(-z --search-zip)'{-z,--search-zip}'[search inside compressed files]'
    '--pre=[filter every file through this command before searching it]:COMMAND:_cmdstring'
    '*''--pre-glob=[run --pre only on the paths matching this glob]:GLOB:_files'
    '(-E --encoding)'{-E+,--encoding=}'[decode input with this character encoding]:ENCODING:_gist_encoding'
    '(--line-buffered --block-buffered)''--line-buffered[flush every finished line as it is found]'
    '(--line-buffered --block-buffered)''--block-buffered[coalesce output into ramped blocks]'
    '--buffer-size=[size the block buffer (default 64K)]:SIZE:'
    '(-p --pretty --plain)'{-p,--pretty}'[color, heading, and line numbers at once]'
    '(-p --pretty --plain)''--plain[print what a pipe would receive, on a terminal]'
    '1: :_gist_verbs'
    '*:path:_files'
  )
  _arguments -s -S -C : "$args[@]" && ret=0
  return ret
}

_gist "$@"
