_gist_words() { COMPREPLY=( $(compgen -W "$1" -- "$2") ); }
# A count or a free-text value: offer nothing rather than a directory
# listing, which is what a generator that cannot read its own flag
# table falls back to.
_gist_none() { COMPREPLY=(); compopt +o default 2> /dev/null; }

# Returns 0 when $1 is a value-taking flag and the value was handled.
_gist_value() {
  case "$1" in
    --field-match-separator) _gist_none; return 0 ;;
    --field-context-separator) _gist_none; return 0 ;;
    --sort) _gist_words "$_gist_sortkey" "$2"; return 0 ;;
    --sortr) _gist_words "$_gist_sortkey" "$2"; return 0 ;;
    -A|--after-context) _gist_none; return 0 ;;
    -B|--before-context) _gist_none; return 0 ;;
    -C|--context) _gist_none; return 0 ;;
    -m|--max-count) _gist_none; return 0 ;;
    -e|--regexp) _gist_none; return 0 ;;
    -t|--type) _gist_words "$_gist_type" "$2"; return 0 ;;
    -T|--type-not) _gist_words "$_gist_type" "$2"; return 0 ;;
    -g|--glob) COMPREPLY=( $(compgen -f -- "$2") ); return 0 ;;
    --iglob) COMPREPLY=( $(compgen -f -- "$2") ); return 0 ;;
    -M|--max-columns) _gist_none; return 0 ;;
    --path-separator) _gist_none; return 0 ;;
    --max-depth|--maxdepth) _gist_none; return 0 ;;
    --max-filesize) _gist_none; return 0 ;;
    --context-separator) _gist_none; return 0 ;;
    -r|--replace) _gist_none; return 0 ;;
    -f|--file) COMPREPLY=( $(compgen -f -- "$2") ); return 0 ;;
    --type-add) _gist_none; return 0 ;;
    --color) _gist_words "$_gist_when" "$2"; return 0 ;;
    --hyperlink|--link) _gist_words "$_gist_target" "$2"; return 0 ;;
    --hyperlink-format) _gist_words "$_gist_target" "$2"; return 0 ;;
    --hostname-bin) COMPREPLY=( $(compgen -c -- "$2") ); return 0 ;;
    --ignore-file) COMPREPLY=( $(compgen -f -- "$2") ); return 0 ;;
    --rank) _gist_none; return 0 ;;
    --colors) _gist_none; return 0 ;;
    -j|--threads) _gist_none; return 0 ;;
    --engine) _gist_words "$_gist_engine" "$2"; return 0 ;;
    --dfa-size-limit|--regex-size-limit) _gist_none; return 0 ;;
    --pre) COMPREPLY=( $(compgen -c -- "$2") ); return 0 ;;
    --pre-glob) COMPREPLY=( $(compgen -f -- "$2") ); return 0 ;;
    -E|--encoding) _gist_words "$_gist_encoding" "$2"; return 0 ;;
    --buffer-size) _gist_none; return 0 ;;
    *) return 1 ;;
  esac
}

_gist() {
  local cur prev
  cur=${COMP_WORDS[COMP_CWORD]}
  prev=${COMP_WORDS[COMP_CWORD-1]}
  COMPREPLY=()
  # bash breaks a word on `=`, so `--flag=<TAB>` puts the flag two back.
  if [[ $prev == '=' && $COMP_CWORD -ge 2 ]]; then
    _gist_value "${COMP_WORDS[COMP_CWORD-2]}" "$cur"
    return 0
  fi
  _gist_value "$prev" "$cur" && return 0
  if [[ $cur == --no* ]]; then
    _gist_words "$_gist_opts $_gist_undo" "$cur"
    return 0
  fi
  if [[ $cur == -* ]]; then
    _gist_words "$_gist_opts" "$cur"
    return 0
  fi
  if (( COMP_CWORD == 1 )); then
    _gist_words "$_gist_verbs" "$cur"
    (( ${#COMPREPLY[@]} )) && return 0
  fi
  return 0
}

complete -F _gist -o bashdefault -o default gist
