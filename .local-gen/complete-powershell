    [CompletionResult]::new('--pre', '--pre', [CompletionResultType]::ParameterName, 'filter every file through this command before searching it')
    [CompletionResult]::new('--pre-glob', '--pre-glob', [CompletionResultType]::ParameterName, 'run --pre only on the paths matching this glob')
    [CompletionResult]::new('-E', '-E', [CompletionResultType]::ParameterName, 'decode input with this character encoding')
    [CompletionResult]::new('--encoding', '--encoding', [CompletionResultType]::ParameterName, 'decode input with this character encoding')
    [CompletionResult]::new('--line-buffered', '--line-buffered', [CompletionResultType]::ParameterName, 'flush every finished line as it is found')
    [CompletionResult]::new('--block-buffered', '--block-buffered', [CompletionResultType]::ParameterName, 'coalesce output into ramped blocks')
    [CompletionResult]::new('--buffer-size', '--buffer-size', [CompletionResultType]::ParameterName, 'size the block buffer (default 64K)')
    [CompletionResult]::new('-p', '-p', [CompletionResultType]::ParameterName, 'color, heading, and line numbers at once')
    [CompletionResult]::new('--pretty', '--pretty', [CompletionResultType]::ParameterName, 'color, heading, and line numbers at once')
    [CompletionResult]::new('--plain', '--plain', [CompletionResultType]::ParameterName, 'print what a pipe would receive, on a terminal')
  ) | Where-Object { $_.CompletionText -like "$wordToComplete*" }
}
