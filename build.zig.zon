.{
    .name = .gist,
    .version = "1.0.0", // x-release-please-version
    .fingerprint = 0x93c97f19b94b6ad4,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Sibling-checkout path deps (dev). Releases pin url+hash via the
        // publish script — see the ecosystem split plan.
        .irregex = .{ .path = "../irregex" },
        // The shard-aware test runner (build-time only, no artifact, no ABI).
        // Reached directly rather than through `irregex`, which used to carry
        // a copy of it.
        .brigade = .{ .path = "../brigade" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "bindings",
        "editor",
        "shell",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "NOTICE",
    },
}
